# =============================================================================
# ModelPricer V3 — Frontend Environment Variables (.env.local)
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.
#
# All frontend env vars MUST start with VITE_ to be exposed to the browser.
# See: https://vite.dev/guide/env-and-mode
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these values from Firebase Console > Project Settings > General > Your apps
# These are client-side keys and are safe to use in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Analytics (OPTIONAL)
# Only needed if you want Google Analytics integration.
# Omit or leave empty to skip analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Supabase Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# Required only if using Supabase for data storage (dual-write or supabase mode).
# If omitted, the app falls back to localStorage-only mode.
# Get these from Supabase Dashboard > Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IMPORTANT: Never put the Supabase service_role key here!
# The service_role key is server-only and must NOT start with VITE_.

# -----------------------------------------------------------------------------
# Auth Provider (OPTIONAL)
# -----------------------------------------------------------------------------
# Which authentication provider to use. Default: firebase
# Options: firebase | supabase (supabase auth is not yet implemented)
VITE_AUTH_PROVIDER=firebase

# -----------------------------------------------------------------------------
# API Base URL (OPTIONAL)
# -----------------------------------------------------------------------------
# Override the backend API URL. Leave empty to use the Vite dev proxy
# (recommended for local development — proxy is configured in vite.config.mjs).
# In production, set this to your backend URL (e.g., https://api.yourdomain.com).
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# App URL (OPTIONAL)
# -----------------------------------------------------------------------------
# App URL for OAuth redirects (Supabase Auth)
# In production, set this to your public domain (e.g., https://app.yourdomain.com).
VITE_APP_URL=http://localhost:4028

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (OPTIONAL)
# -----------------------------------------------------------------------------
# If set, the frontend will report uncaught errors and performance data to Sentry.
# Get DSN from Sentry Dashboard > Settings > Projects > Client Keys (DSN).
# If omitted, Sentry is completely disabled (zero overhead).
VITE_SENTRY_DSN=

# Application version string sent with every Sentry event.
# Useful for filtering errors by release in the Sentry dashboard.
VITE_APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Stripe Payments (OPTIONAL — frontend publishable key)
# -----------------------------------------------------------------------------
# Stripe publishable key (starts with pk_test_ or pk_live_).
# This is the PUBLIC key — safe for browser use.
# Only needed if you plan to use Stripe Elements (not required for Checkout redirect).
# Get it from Stripe Dashboard > Developers > API keys.
VITE_STRIPE_PUBLIC_KEY=
