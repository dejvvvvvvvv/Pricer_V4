# =============================================================================
# ModelPricer V3 — Backend Environment Variables (backend-local/.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Backend port (default: 3001, proxied by Vite on port 4028)
PORT=3001

# Environment mode. Set to "production" in production to:
# - Hide filesystem paths in error responses
# - Enable stricter tenant header validation
NODE_ENV=development

# -----------------------------------------------------------------------------
# PrusaSlicer Configuration
# -----------------------------------------------------------------------------

# Absolute path to PrusaSlicer CLI executable.
# Windows: path to prusa-slicer-console.exe
# Linux/Mac: path to prusa-slicer binary
# If omitted, backend will try to auto-detect it under ../tools/prusaslicer/**/prusa-slicer-console.exe
PRUSA_SLICER_CMD=

# Where slicer jobs (uploads + outputs) will be stored.
# Recommended: Use a short path without spaces.
# Windows default: C:\modelpricer\tmp
# Linux/Mac default: /tmp/modelpricer
SLICER_WORKSPACE_ROOT=C:\modelpricer\tmp

# Default INI profile used if the request doesn't upload a custom ini.
# Create this by exporting a profile from PrusaSlicer GUI.
PRUSA_DEFAULT_INI=C:\modelpricer\profiles\default.ini

# -----------------------------------------------------------------------------
# Firebase Admin SDK (REQUIRED for auth middleware)
# -----------------------------------------------------------------------------

# Firebase project ID — required for verifying Firebase ID tokens.
# Get this from Firebase Console > Project Settings > General.
FIREBASE_PROJECT_ID=

# Path to Firebase service account JSON file (OPTIONAL for development).
# Required in production for full Admin SDK functionality.
# Download from Firebase Console > Project Settings > Service accounts.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# -----------------------------------------------------------------------------
# Supabase JWT (REQUIRED for dual auth — Firebase + Supabase)
# -----------------------------------------------------------------------------

# Supabase project URL — required for JWT issuer validation.
# Get this from Supabase Dashboard > Settings > API > Project URL.
# Must match the VITE_SUPABASE_URL used in the frontend .env.local.
SUPABASE_URL=

# JWT secret used to verify Supabase access tokens (HS256).
# Get this from Supabase Dashboard > Settings > API > JWT Secret.
# This is a long base64-encoded string (40+ characters), NOT the anon key.
# If omitted, only Firebase tokens will be accepted.
SUPABASE_JWT_SECRET=

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Allowed frontend origins (comma-separated).
# Use * for prototype/development (allows all origins).
# In production, list only your actual frontend domains.
CORS_ORIGINS=http://localhost:4028,http://127.0.0.1:4028,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------

# Email provider: none (demo/logging only), resend (production), smtp, sendgrid
EMAIL_PROVIDER=none

# Resend API key — required when EMAIL_PROVIDER=resend.
# Get it from https://resend.com/api-keys
RESEND_API_KEY=

# Default sender address for outgoing emails.
EMAIL_FROM=noreply@modelpricer.app

# -----------------------------------------------------------------------------
# Invoicing (Czech invoice details)
# -----------------------------------------------------------------------------

# Supplier company info (printed on invoices)
INVOICE_COMPANY_NAME=
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_ICO=
INVOICE_COMPANY_DIC=

# Bank account for payment
INVOICE_BANK_ACCOUNT=
INVOICE_BANK_IBAN=

# Is the supplier a VAT payer? (true/false)
# false = invoice shows "Nejsem platce DPH"
# true  = invoice shows VAT breakdown (21%)
INVOICE_VAT_PAYER=false

# -----------------------------------------------------------------------------
# Storage (OPTIONAL)
# -----------------------------------------------------------------------------

# Persistent data root (not required for the prototype)
MODELPRICER_DATA_ROOT=C:\modelpricer\data

# -----------------------------------------------------------------------------
# Storage Provider ('filesystem' | 'r2')
# -----------------------------------------------------------------------------
# Which backend to use for file storage (order files, uploads, etc.).
# Default: 'filesystem' — stores files on the local disk under STORAGE_ROOT.
# Set to 'r2' for Cloudflare R2 object storage (production / cloud deployment).
STORAGE_PROVIDER=filesystem

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (OPTIONAL)
# -----------------------------------------------------------------------------
# If set, the backend will report uncaught errors and performance data to Sentry.
# Get DSN from Sentry Dashboard > Settings > Projects > Client Keys (DSN).
# If omitted, Sentry is completely disabled (zero overhead).
SENTRY_DSN=

# Application version string sent with every Sentry event.
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
# -----------------------------------------------------------------------------
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=modelpricer-files
# Optional: public bucket URL for unsigned access (e.g. CDN).
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Stripe Payments (OPTIONAL — enables card payment via Stripe Checkout)
# -----------------------------------------------------------------------------

# Stripe secret API key (starts with sk_test_ or sk_live_).
# Get it from Stripe Dashboard > Developers > API keys.
# NEVER expose this key in frontend code or commit to git.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_).
# Get it from Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Required for verifying webhook event signatures.
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key (starts with pk_test_ or pk_live_).
# This is the PUBLIC key — safe for frontend use.
# Only needed if you plan to use Stripe Elements (not required for Checkout redirect).
STRIPE_PUBLIC_KEY=
